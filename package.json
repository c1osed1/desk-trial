{
  "name": "desk-trial",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "4 этапа",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:01": "vitest run --project backend",
    "test:02": "vitest run --project frontend",
    "test:03": "vitest run --project database",
    "test:04": "vitest run --project redis",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down -v"
  },
  "dependencies": {
    "fastify": "^5.7.4",
    "ioredis": "^5.4.1",
    "pg": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
